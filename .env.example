# =====================================================================
# Cau hinh Docker Oracle Free
# =====================================================================
ORACLE_PORT=1521
ORACLE_PWD=YourSysPasswordHere123#

# =====================================================================
# Cau hinh ket noi Database ung dung (User hotel_app tren PDB FREEPDB1)
# =====================================================================
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE_NAME=FREEPDB1
DB_USERNAME=hotel_app
DB_PASSWORD=YourHotelAppPasswordHere123#

# =====================================================================
# Cau hinh Bao mat & JWT
# =====================================================================
# Khoa bi mat JWT (toi thieu 256 bits = 32 ky tu, nen dung chuoi ngau nhien manh)
JWT_SECRET=your-256-bit-secret-your-256-bit-secret-hotel-key
JWT_EXPIRATION_MS=86400000

# =====================================================================
# Tai khoan Quan tri vien mac dinh khoi tao lan dau (CommandLineRunner)
# =====================================================================
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@Hotel2026!
INITIAL_ADMIN_EMAIL=admin@demohotel.vn
